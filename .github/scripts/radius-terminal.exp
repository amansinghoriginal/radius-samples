if {$argc < 5} {
    puts stderr "usage: radius-terminal.exp MODE TIMEOUT WORKING_DIRECTORY TRANSCRIPT COMMAND \[ARG...\]"
    exit 2
}

set mode [lindex $argv 0]
set command_timeout [lindex $argv 1]
set working_directory [file normalize [lindex $argv 2]]
set transcript [file normalize [lindex $argv 3]]
set command [lrange $argv 4 end]

if {$mode ni {default next none}} {
    puts stderr "mode must be one of: default, next, none"
    exit 2
}
if {![string is integer -strict $command_timeout] || $command_timeout < 0} {
    puts stderr "timeout must be a non-negative integer"
    exit 2
}

set timeout $command_timeout
if {$command_timeout == 0} {
    set timeout -1
}

cd $working_directory
log_file -noappend $transcript
log_user 1

spawn {*}$command

# Lip Gloss and Bubble Tea query terminal capabilities before rendering.
after 100 {
    send -- "\033]11;rgb:0000/0000/0000\033\\"
    send -- "\033\[?1;2c"
}

if {$mode == "default"} {
    after 3000 {
        send -- "\r"
    }
} elseif {$mode == "next"} {
    after 3000 {
        send -- "\033\[B"
        send -- "\r"
    }
}

expect {
    eof {
        set result [wait]
        exit [lindex $result 3]
    }
    timeout {
        puts stderr "Radius command did not complete within $command_timeout seconds"
        exit 124
    }
}
