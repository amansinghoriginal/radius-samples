if {$argc != 2} {
    puts stderr "usage: quickstart-run.exp WORKING_DIRECTORY TRANSCRIPT"
    exit 2
}

set working_directory [file normalize [lindex $argv 0]]
set transcript [file normalize [lindex $argv 1]]
set timeout -1

cd $working_directory
log_file -noappend $transcript
log_user 1

spawn rad run app.bicep

after 100 {
    send -- "\033]11;rgb:0000/0000/0000\033\\"
    send -- "\033\[?1;2c"
}

expect eof
set result [wait]
exit [lindex $result 3]
