if {$argc != 2} {
    puts stderr "usage: quickstart-delete.exp WORKING_DIRECTORY TRANSCRIPT"
    exit 2
}

set working_directory [file normalize [lindex $argv 0]]
set transcript [file normalize [lindex $argv 1]]
set timeout 300

cd $working_directory
log_file -noappend $transcript
log_user 1

spawn rad app delete todolist

after 100 {
    send -- "\033]11;rgb:0000/0000/0000\033\\"
    send -- "\033\[?1;2c"
}

# The deletion prompt defaults to "No". Select "Yes" and submit it.
after 3000 {
    send -- "\033\[B"
    send -- "\r"
}

expect {
    eof {
        set result [wait]
        exit [lindex $result 3]
    }
    timeout {
        puts stderr "rad app delete did not complete within five minutes"
        exit 124
    }
}
